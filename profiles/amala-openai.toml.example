[profile]
name = "default"
language = "en"

[trigger]
wake_word_enabled = true
single_turn_mode = false

[trigger.wake_word]
phrase = "Amala"
engine = "auto"
language = "en"

[stt]
provider = "openai-api"
provider_user_selected = true
fallback = "faster-whisper"
model = "base"
device = "cpu"
compute_type = "int8"
wake_model = "base"
wake_device = "cpu"
wake_compute_type = "int8"
language = "en"

[tts]
provider = "piper-local"
fallback = "piper-local"
language_code = "en-US"
streaming = true
allow_sapi5_fallback = true

[brain]
primary = "openai"
deep_brain = "openai"
routing_provider = "openai"
routing_model = "gpt-5.5"
local_fallback = "openai"
local_fallback_model = "gpt-5.5"
reply_language = "en"

[brain.providers.openai]
model = "gpt-5.5"
deep_model = "gpt-5.5"

[brain.providers.ollama]
model = "qwen3:1.7b"
deep_model = "qwen3:4b"
tool_model = "qwen3:4b"
base_url = "http://127.0.0.1:11434"
autostart = true

[audio]
input_device = "auto"
output_device = "auto"
echo_cancellation = true
sample_rate = 16000

[ui]
tray_enabled = true
startup_chime = true
orb_style = "jarvis_bar"
bar_persistent = true

[autostart]
enabled = true
start_minimized = false
background_only = false

[computer_use]
enabled = true
screen_indicator = true
strict_verify = true

[local_action]
enabled = true

[memory]
recall_store = "sqlite"
archival_store = "sqlite"
data_dir = "./data"
